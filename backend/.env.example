# Server
# PORT is honored when explicitly set. Otherwise local helpers use 8000 and
# select the next available port if 8000 is occupied.
PORT=8000
NODE_ENV=development

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# CORS — comma-separated allowlist of client origins.
# When unset in development, the backend allows Vite localhost and LAN
# origins on VITE_PORT (default 5173). Set this explicitly for production or
# other hosts. CLIENT_URL remains authoritative when set.
# CLIENT_URL=http://localhost:5173,http://192.168.8.41:5173
CLIENT_URL=
VITE_PORT=5173

# Multiset WebXR SDK credentials — keep real values in backend/.env or root .env only.
MULTISET_CLIENT_ID=
MULTISET_CLIENT_SECRET=
MULTISET_MAP_CODE=MAP_GCEL3WD6ACQL
