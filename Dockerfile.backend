# BSU Visitor — backend
# Multi-stage: build deps in one stage, run in a slim stage with prod-only modules.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# better-sqlite3 needs the prebuilt binary to match the runtime; using the
# slim image with same node major as the build stage avoids a node-gyp rebuild.
COPY --from=deps /app/node_modules ./node_modules
COPY backend/ ./
# SQLite DB + uploads live on a mounted volume; create the dir so first run
# can write to it without 500s.
RUN mkdir -p /app/src/database /app/uploads
EXPOSE 8765
CMD ["node", "src/server.js"]
