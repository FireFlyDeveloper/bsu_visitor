# Base URL the client uses to call the API.
# In dev, the Vite proxy (see vite.config.js) lets you leave this as "/api".
# In production, set to the deployed backend origin, e.g. https://api.bsu-visitor.app
VITE_API_BASE=/api

# Public origin embedded in the kiosk navigation QR code, e.g. https://visitor.ffly.site.
# Defaults to the browser's window.location.origin when unset.
# VITE_PUBLIC_ORIGIN=

# Where the Vite dev server should proxy /api and /uploads to.
# Defaults to the development backend on port 8765 if unset.
VITE_API_PROXY_TARGET=http://localhost:8765

# Optional Vite dev-server port (independent of the backend PORT).
# VITE_PORT=5173

# Comma-separated list of allowed Host headers for the Vite dev server.
# Include any ngrok / tunnel host you use, e.g. my-tunnel.ngrok-free.app
VITE_ALLOWED_HOSTS=localhost

# Multiset auth proxy. Credentials stay server-side; the browser only receives a short-lived token.
VITE_MULTISET_AUTH_ENDPOINT=/api/multiset/token
