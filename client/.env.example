# Base URL the client uses to call the API.
# In dev, the Vite proxy (see vite.config.js) lets you leave this as "/api".
# In production, set to the deployed backend origin, e.g. https://api.bsu-visitor.app
VITE_API_BASE=/api

# Where the Vite dev server should proxy /api and /uploads to.
# Defaults to http://localhost:8000 if unset.
VITE_API_PROXY_TARGET=http://localhost:8000

# Comma-separated list of allowed Host headers for the Vite dev server.
# Include any ngrok / tunnel host you use, e.g. my-tunnel.ngrok-free.app
VITE_ALLOWED_HOSTS=localhost
